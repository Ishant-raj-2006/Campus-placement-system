PORT=5000
JWT_SECRET=your_jwt_secret_key

# Firebase Configuration Options
# Option 1: Place serviceAccountKey.json file in backend/config/serviceAccountKey.json

# Option 2: Provide individual Firebase env vars
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 3: Full JSON string in single env variable
# FIREBASE_SERVICE_ACCOUNT_KEY='{ "type": "service_account", ... }'
